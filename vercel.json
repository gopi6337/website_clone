{
  "buildCommand": "npm install -g pnpm && pnpm install && pnpm exec vite build && node generate-spa-pages.js",
  "outputDirectory": "dist/public",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    { "source": "/curriculum/uae-\\(dubai\\)", "destination": "/curriculum/uae", "permanent": true },
    { "source": "/curriculum/uae-\\(dubai\\)/", "destination": "/curriculum/uae", "permanent": true },
    { "source": "/curriculum/uae-%28dubai%29", "destination": "/curriculum/uae", "permanent": true },
    { "source": "/curriculum/uae-%28dubai%29/", "destination": "/curriculum/uae", "permanent": true },
    { "source": "/science-curriculum/uae-\\(dubai\\)", "destination": "/science-curriculum/uae", "permanent": true },
    { "source": "/science-curriculum/uae-\\(dubai\\)/", "destination": "/science-curriculum/uae", "permanent": true },
    { "source": "/science-curriculum/uae-%28dubai%29", "destination": "/science-curriculum/uae", "permanent": true },
    { "source": "/science-curriculum/uae-%28dubai%29/", "destination": "/science-curriculum/uae", "permanent": true },
    { "source": "/tutors", "destination": "/teachers", "permanent": true },
    { "source": "/curriculum", "destination": "/curriculum/united-states", "permanent": true },
    { "source": "/science-curriculum", "destination": "/science-curriculum/united-states", "permanent": true },
    { "source": "/login", "destination": "https://revaai.eduversejr.com/login", "permanent": false },
    { "source": "/404", "destination": "/", "permanent": false },
    { "source": "/:path+/", "destination": "/:path+", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://revaai.eduversejr.com; media-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://formspree.io; object-src 'none'" }
      ]
    }
  ]
}
